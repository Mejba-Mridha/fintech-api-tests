# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your real values.
# NEVER commit the actual .env file. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API under test
BASE_URL=https://api.example-fintech.com/v1

# Authentication credentials (use a dedicated test account, not production)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=YourTestPassword123

# API keys / tokens (injected by GitHub Actions Secrets in CI)
API_KEY=your_api_key_here
AUTH_TOKEN=your_bearer_token_here

# Test data config
DEFAULT_ACCOUNT_ID=acc_test_000001
DEFAULT_CURRENCY=USD

# Environment tag (dev | staging | production)
ENV=staging
